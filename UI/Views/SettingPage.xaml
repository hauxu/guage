<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:SettingPanel="clr-namespace:UI.Controls.SettingPanel"
      xmlns:Btn="clr-namespace:UI.Controls.Button"
      xmlns:select="clr-namespace:UI.Controls.Select"
      x:Class="UI.Views.SettingPage"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="SettingPage"
      Foreground="{DynamicResource StandardTextBrush}" Background="Transparent">
    <Page.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SettingPanelBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingPanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SettingsHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSecondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBorder" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource ThemeBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SettingPanelSpliteLineBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource ThemeBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24,20,24,40" MaxWidth="980">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,24">
            <TextBlock Text="设置" FontSize="{DynamicResource AppFontSizeDisplay}" FontWeight="SemiBold"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsCard}" Padding="10">
            <ListBox ItemsSource="{Binding TabbarData}"
                     SelectedIndex="{Binding TabbarSelectedIndex, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SettingsNavItem}"/>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="{DynamicResource AppFontSizeBody}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="1" Grid.Column="2">
            <SettingPanel:SettingPanel x:Name="ConfigPanel" Data="{Binding Data, Mode=TwoWay}"
                                       Visibility="{Binding IsConfigTabVisible}"/>

            <StackPanel Visibility="{Binding IsDataTabVisible}">
                <TextBlock Text="数据管理" Style="{StaticResource SettingsSectionTitle}"/>

                <TextBlock Text="删除数据" Foreground="#f54f4e" FontSize="{DynamicResource AppFontSizeBody}" FontWeight="SemiBold"/>
                <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="从" VerticalAlignment="Center"/>
                        <select:DateSelect Date="{Binding DelDataStartMonthDate, Mode=TwoWay}" Margin="10,0" SelectType="Month"/>
                        <TextBlock Text="到" VerticalAlignment="Center"/>
                        <select:DateSelect Date="{Binding DelDataEndMonthDate, Mode=TwoWay}" Margin="10,0" SelectType="Month"/>
                        <Btn:Button Margin="20,0,0,0" Icon="Delete" Content="执行" MinWidth="88"
                                    Background="#f51837" Foreground="White"
                                    Command="{Binding DelDataCommand}" ToolTip="删除并且不可恢复"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="导出数据" FontSize="{DynamicResource AppFontSizeBody}" FontWeight="SemiBold" Margin="0,20,0,0"/>
                <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsHint}" Text="xlsx / csv"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="从" VerticalAlignment="Center"/>
                            <select:DateSelect Date="{Binding ExportDataStartMonthDate, Mode=TwoWay}" Margin="10,0" SelectType="Month"/>
                            <TextBlock Text="到" VerticalAlignment="Center"/>
                            <select:DateSelect Date="{Binding ExportDataEndMonthDate, Mode=TwoWay}" Margin="10,0" SelectType="Month"/>
                            <Btn:Button Margin="20,0,0,0" Icon="Share" Content="导出" MinWidth="88" Command="{Binding ExportDataCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsAboutTabVisible}">
                <StackPanel HorizontalAlignment="Left">
                    <Image Width="32" Source="/Resources/Icons/guage.ico" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock VerticalAlignment="Center" FontSize="{DynamicResource AppFontSizeBody}">
                            <Run Text="更矩 版本号 "/><Run Text="{Binding Version}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <Btn:Button Visibility="{Binding CheckUpdateBtnVisibility}" Command="{Binding CheckUpdate}"
                                    Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="120"
                                    Icon="SetlockScreen" Content="检查更新"/>
                    </StackPanel>
                    <TextBlock Margin="0,24,0,0" Style="{StaticResource SettingsSectionTitle}" Text="浏览器扩展安装"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Btn:Button Command="{Binding OpenURL}" CommandParameter="{Binding ChromeWebStoreUrl}"
                                    MinWidth="120" Icon="Shop" Content="Chrome 商店"/>
                        <Btn:Button Command="{Binding OpenURL}" CommandParameter="{Binding EdgeAddOnsUrl}"
                                    Margin="12,0,0,0" MinWidth="120" Icon="Globe" Content="Edge 商店"/>
                    </StackPanel>
                    <TextBlock Margin="0,16,0,0" Style="{StaticResource SettingsHint}"
                               Text="或加载仓库内 Guage.Chrome 目录（需开开发者模式）。"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Btn:Button Command="{Binding OpenBrowserExtensionFolderCommand}"
                                    MinWidth="160"
                                    Icon="OpenFolderHorizontal"
                                    Content="打开扩展目录"/>
                        <Btn:Button Command="{Binding OpenURL}" CommandParameter="{Binding ExtensionInstallGuideUrl}"
                                    Margin="12,0,0,0" MinWidth="120" Icon="Help" Content="安装说明"/>
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0" FontSize="{DynamicResource AppFontSizeSecondary}">
                        <Run Text="开源 "/><Hyperlink Command="{Binding OpenURL}" CommandParameter="https://github.com/YOUR_GITHUB/guage">https://github.com/YOUR_GITHUB/guage</Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,8,0,0" FontSize="{DynamicResource AppFontSizeSecondary}">
                        <Run Text="讨论 "/><Hyperlink Command="{Binding OpenURL}" CommandParameter="https://github.com/YOUR_GITHUB/guage/discussions">https://github.com/YOUR_GITHUB/guage/discussions</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
