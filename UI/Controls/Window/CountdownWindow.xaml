<Window x:Class="UI.Controls.Window.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:btn="clr-namespace:UI.Controls.Button"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowActivated="False">
    <Border x:Name="RootBorder" Background="#D91F1F24" CornerRadius="16" Padding="22,14"
            BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <StackPanel Width="210">
            <TextBlock x:Name="CountdownText" FontSize="{DynamicResource AppFontSizeDisplay}" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="White"/>
            <TextBlock x:Name="HintText" Margin="0,6,0,0" FontSize="{DynamicResource AppFontSizeCaption}"
                       HorizontalAlignment="Center" Foreground="#B3FFFFFF"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Text="拖动 · 三击隐藏 · 到时结束"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <btn:Button Content="延长 5 分钟" Width="96" Height="30" Click="ExtendButton_Click"/>
                <btn:Button Content="取消" Width="72" Height="30" Margin="8,0,0,0" Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
