<Window x:Class="UI.Controls.Window.FloatingTipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:base="clr-namespace:UI.Controls.Base"
        Title="FloatingTip" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True">
    <!--短命提示窗：不用 DropShadowEffect（24px 高斯会强制整窗走位图管线，
        与逐帧淡入淡出叠加时在低配机上明显掉帧），改用边框+底色分层替代阴影-->
    <Border x:Name="TipCard" Background="{DynamicResource StandardBackgroundBrush2}"
            BorderBrush="{DynamicResource ThemeBrush}" BorderThickness="1"
            CornerRadius="12" Padding="18,14" MouseLeftButtonUp="TipCard_MouseLeftButtonUp">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <base:Icon IconType="IncidentTriangle" FontSize="{DynamicResource AppFontSizeTitle}"
                       Foreground="{DynamicResource ThemeBrush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" FontSize="{DynamicResource AppFontSizeBody}" FontWeight="SemiBold"
                           Foreground="{DynamicResource StandardTextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" Margin="0,6,0,0" FontSize="{DynamicResource AppFontSizeSecondary}"
                           Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
