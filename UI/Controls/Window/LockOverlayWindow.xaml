<Window x:Class="UI.Controls.Window.LockOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:btn="clr-namespace:UI.Controls.Button"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Border Background="#F2FFFFFF" CornerRadius="20" Padding="36,30" MaxWidth="440"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold"
                           Foreground="#1F1F24" HorizontalAlignment="Center"/>
                <TextBlock x:Name="MessageText" Margin="0,14,0,0" TextWrapping="Wrap"
                           Foreground="#5F6368" HorizontalAlignment="Center"/>

                <Border Background="#F1F3F4" CornerRadius="14" Padding="18,14" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="输入密码解锁" FontSize="13" Foreground="#5F6368"/>
                        <PasswordBox x:Name="PasswordInput" Margin="0,10,0,0" Height="40"
                                     FontSize="16" Padding="10,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock x:Name="ErrorText" Foreground="#D93025" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="RandomPasswordText" Foreground="#1A73E8" FontSize="13"
                                       VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <btn:Button x:Name="ShowPwdButton" Content="临时查看随机密码" Width="140" Height="36"
                                Click="ShowPwdButton_Click"/>
                    <btn:Button x:Name="ExtendBtn" Content="延长 5 分钟" Width="110" Height="36" Margin="10,0,0,0"
                                Click="ExtendButton_Click"/>
                    <btn:Button Content="解锁" Width="96" Height="36" Margin="10,0,0,0"
                                Background="{DynamicResource ThemeBrush}" Foreground="White"
                                Click="ConfirmButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
