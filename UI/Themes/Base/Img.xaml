<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:UI.Controls.Base">
    <Style TargetType="{x:Type local:Img}">
        <Setter Property="SnapsToDevicePixels"
          Value="true" />
        <Setter Property="UseLayoutRounding" Value="True"/>

        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Radius" Value="5"/>
        <Setter Property="Background" Value="Transparent"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Img}">
                    <Border Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            CornerRadius="{TemplateBinding Radius}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"
                            ClipToBounds="True">
                        <Image x:Name="image"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:Img}}, Path=Src}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
