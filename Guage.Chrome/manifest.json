{
    "manifest_version": 3,
    "name": "更矩 网页统计",
    "description": "记录网页浏览时长，只与本机 更矩 通信。",
    "version": "1.0.0",
    "minimum_chrome_version": "116",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_title": "更矩 网页统计",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "permissions": [
        "tabs",
        "windows",
        "storage"
    ],
    "host_permissions": [
        "http://127.0.0.1:8909/*",
        "http://127.0.0.1:8911/*",
        "http://127.0.0.1:8913/*"
    ],
    "browser_specific_settings": {
        "edge": {
            "browser_action_next_to_addressbar": true
        }
    }
}
