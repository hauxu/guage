<Application x:Class="UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UI"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Startup="OnStartup"
             xmlns:base="clr-namespace:UI.Controls.Base"
             >
    <Application.Resources>
        <ResourceDictionary>
            <!-- 陈述/正文字号基准 15pt，辅助与标题按层级递减 -->
            <sys:Double x:Key="AppFontSizeBody">15</sys:Double>
            <sys:Double x:Key="AppFontSizeSecondary">13</sys:Double>
            <sys:Double x:Key="AppFontSizeCaption">11</sys:Double>
            <sys:Double x:Key="AppFontSizeTitle">18</sys:Double>
            <sys:Double x:Key="AppFontSizeDisplay">22</sys:Double>

            <sys:Double x:Key="AppFontSizeNav">14</sys:Double>
            <sys:Double x:Key="AppFontSizeNavCompact">13</sys:Double>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="{x:Type Label}">
                <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
            </Style>
            <Style TargetType="{x:Type PasswordBox}">
                <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
            </Style>
            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
            </Style>
            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
            </Style>
            <Style TargetType="{x:Type RadioButton}">
                <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/guage;component/Resources/Themes/Light.xaml"/>
                <ResourceDictionary Source="/guage;component/Resources/Themes/Common.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
       
        

    </Application.Resources>
</Application>
