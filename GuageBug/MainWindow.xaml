<Window x:Class="GuageBug.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GuageBug"
        mc:Ignorable="d"
        Title="更矩 崩溃了" Height="372" Width="390" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(Border.RenderTransform).
               (TranslateTransform.Y)"
                                          Storyboard.TargetName="IconGray">
                            <EasingDoubleKeyFrame KeyTime="00:00:4.0"
                                   Value="20" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <StackPanel>

            <Image x:Name="IconGray" Width="120"
               HorizontalAlignment="Center" VerticalAlignment="Top" Source="/ghost_gray (320).ico" >
                <Image.Effect>
                    <DropShadowEffect BlurRadius="10" Direction="0" ShadowDepth="0" Color="Black" Opacity="0.1"/>
                </Image.Effect>
                <Image.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Image.RenderTransform>

            </Image>
            <Border Background="#f3f3f3" CornerRadius="6" Padding="10" Margin="0,-50,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="0" Direction="40" ShadowDepth="4" Color="#FFF7F7F7" Opacity="1"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Foreground="Gray" Text="更矩 崩溃了" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Run Text="日志已保存，可提交到"/><Hyperlink ToolTip="定位该日志文件" Click="LogHyperlinkClick">日志目录</Hyperlink><Run Text="或"/>
                        <Hyperlink ToolTip="浏览器打开" Click="IssuesHyperlinkClick">Issues</Hyperlink><Run Text="。"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Left">
            <Button Click="Restart">
                <Button.Template>
                    <ControlTemplate>
                        <Border Background="#2b20d9"  Padding="10,10" CornerRadius="4">
                            <TextBlock Text="重启" Foreground="White"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>

</Window>
